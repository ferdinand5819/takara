# 自宅の緯度・経度（Google Maps で確認できます）
HOME_LAT=35.6762
HOME_LON=139.6503

# 自宅とみなす半径 (km)
HOME_RADIUS_KM=0.5

# LINE Messaging API（手順は README 参照）
LINE_CHANNEL_TOKEN=your_channel_access_token_here
LINE_USER_ID=your_line_user_id_here

# MacroDroid からのリクエストを認証するトークン（任意の文字列を設定）
SECRET_TOKEN=your_secret_token_here

# Google Maps Directions API（任意・なければ地図リンクのみ送信）
GOOGLE_MAPS_KEY=your_google_maps_api_key_here
